#include "virtio_gpu.h"
#include "serial.h"

#define VIRTIO_VENDOR_ID 0x1AF4
#define VIRTIO_GPU_DEVICE_ID_LEGACY 0x1050
#define VIRTIO_PCI_HOST_FEATURES 0x00
#define VIRTIO_PCI_GUEST_FEATURES 0x04
#define VIRTIO_PCI_QUEUE_PFN 0x08
#define VIRTIO_PCI_QUEUE_NUM 0x0C
#define VIRTIO_PCI_QUEUE_SEL 0x0E
#define VIRTIO_PCI_QUEUE_NOTIFY 0x10
#define VIRTIO_PCI_STATUS 0x12
#define VIRTIO_PCI_ISR 0x13
#define STATUS_ACK 1
#define STATUS_DRIVER 2
#define STATUS_DRIVER_OK 4
#define DRIVER_QUEUE_SIZE 256
#define VRING_ALIGN 4096

typedef struct {
    unsigned long long addr;
    u32 len;
    u16 flags;
    u16 next;
} __attribute__((packed)) vring_desc_t;

typedef struct {
    u32 id;
    u32 len;
} __attribute__((packed)) vring_used_elem_t;

#define VRING_DESC_F_NEXT 1
#define VRING_DESC_F_WRITE 2
#define VRING_DESC_BYTES_MAX (sizeof(vring_desc_t) * DRIVER_QUEUE_SIZE)
#define VRING_AVAIL_BYTES_MAX (sizeof(u16) * (2 + DRIVER_QUEUE_SIZE))
#define VRING_USED_BYTES_MAX (sizeof(u16) * 2 + sizeof(vring_used_elem_t) * DRIVER_QUEUE_SIZE)
#define VRING_AVAIL_OFFSET VRING_DESC_BYTES_MAX
#define VRING_USED_OFFSET (((VRING_AVAIL_OFFSET + VRING_AVAIL_BYTES_MAX) + (VRING_ALIGN - 1)) & ~(VRING_ALIGN - 1))
#define VRING_TOTAL_BYTES (VRING_USED_OFFSET + VRING_USED_BYTES_MAX)

static virtio_gpu_info_t gpu;
static const pci_device_t *gpu_dev;
static u32 io_base;
static u16 queue_size;
static int ready;
static u8 queue_bytes[VRING_TOTAL_BYTES] __attribute__((aligned(VRING_ALIGN)));
static u32 vring_avail_offset;
static u32 vring_used_offset;
static u32 vring_total_bytes;

static inline void io_wait_spin(void) { volatile int i; for (i = 0; i < 100000; ++i) { } }
static inline u8 v_in8(u16 off) { return inb((u16)(io_base + off)); }
static inline u16 v_in16(u16 off) { u16 v; __asm__ volatile("inw %1, %0" : "=a"(v) : "Nd"((u16)(io_base + off))); return v; }
static inline u32 v_in32(u16 off) { u32 v; __asm__ volatile("inl %1, %0" : "=a"(v) : "Nd"((u16)(io_base + off))); return v; }
static inline void v_out8(u16 off, u8 v) { outb((u16)(io_base + off), v); }
static inline void v_out16(u16 off, u16 v) { __asm__ volatile("outw %0, %1" : : "a"(v), "Nd"((u16)(io_base + off))); }
static inline void v_out32(u16 off, u32 v) { __asm__ volatile("outl %0, %1" : : "a"(v), "Nd"((u16)(io_base + off))); }

static u32 pci_bar0_io(const pci_device_t *dev) {
    u32 bar = pci_read_bar32(dev, 0);
    if (!(bar & 1u)) return 0;
    return bar & ~3u;
}

static vring_desc_t *queue_desc(void) { return (vring_desc_t*)(void*)queue_bytes; }
static u16 *queue_avail_flags_ptr(void) { return (u16*)(void*)(queue_bytes + vring_avail_offset); }
static u16 *queue_avail_idx_ptr(void) { return (u16*)(void*)(queue_bytes + vring_avail_offset + sizeof(u16)); }
static u16 *queue_avail_ring(void) { return (u16*)(void*)(queue_bytes + vring_avail_offset + sizeof(u16) * 2); }
static u16 *queue_used_idx_ptr(void) { return (u16*)(void*)(queue_bytes + vring_used_offset + sizeof(u16)); }

static void queue_layout_init(u16 qsz) {
    u32 avail_bytes = (u32)(sizeof(u16) * (2 + qsz));
    u32 used_bytes = (u32)(sizeof(u16) * 2 + sizeof(vring_used_elem_t) * qsz);
    vring_avail_offset = (u32)(sizeof(vring_desc_t) * qsz);
    vring_used_offset = (vring_avail_offset + avail_bytes + (VRING_ALIGN - 1)) & ~(VRING_ALIGN - 1);
    vring_total_bytes = vring_used_offset + used_bytes;
}

static void queue_reset_memory(void) {
    u8 *p = (u8*)queue_bytes;
    u32 i;
    for (i = 0; i < vring_total_bytes; ++i) p[i] = 0;
}

static int virtio_gpu_queue_init(void) {
    u32 qsz;
    u32 pfn;
    if (!gpu_dev || !io_base) return 0;
    v_out8(VIRTIO_PCI_STATUS, 0);
    v_out8(VIRTIO_PCI_STATUS, STATUS_ACK);
    v_out8(VIRTIO_PCI_STATUS, STATUS_ACK | STATUS_DRIVER);
    v_out32(VIRTIO_PCI_GUEST_FEATURES, 0);
    qsz = 0;
    v_out16(VIRTIO_PCI_QUEUE_SEL, 0);
    qsz = v_in16(VIRTIO_PCI_QUEUE_NUM);
    if (!qsz) return 0;
    if (qsz > DRIVER_QUEUE_SIZE) qsz = DRIVER_QUEUE_SIZE;
    queue_size = (u16)qsz;
    queue_layout_init(queue_size);
    if (vring_total_bytes > sizeof(queue_bytes)) return 0;
    queue_reset_memory();
    pfn = ((u32)(unsigned long)queue_bytes) >> 12;
    v_out32(VIRTIO_PCI_QUEUE_PFN, 0);
    v_out16(VIRTIO_PCI_QUEUE_SEL, 0);
    v_out32(VIRTIO_PCI_QUEUE_PFN, pfn);
    if (v_in32(VIRTIO_PCI_QUEUE_PFN) != pfn) return 0;
    v_out8(VIRTIO_PCI_STATUS, STATUS_ACK | STATUS_DRIVER | STATUS_DRIVER_OK);
    ready = 1;
    gpu.initialized = 1;
    return 1;
}

static int virtio_gpu_submit_common(void *a, u32 al, void *b, u32 bl, void *r, u32 rl, int desc_count) {
    vring_desc_t *desc;
    u16 *avail_flags;
    u16 *avail_idx;
    u16 *avail_ring;
    u16 *used_idx;
    u16 start_idx;
    u32 paddr_queue;
    u32 spins = 0;
    if (!ready || !a || !r) return -1;
    if ((desc_count == 2 && queue_size < 2) || (desc_count == 3 && queue_size < 3)) return -1;
    desc = queue_desc();
    avail_flags = queue_avail_flags_ptr();
    avail_idx = queue_avail_idx_ptr();
    avail_ring = queue_avail_ring();
    used_idx = queue_used_idx_ptr();
    paddr_queue = (u32)(unsigned long)queue_bytes;
    if (((paddr_queue >> 12) & 0xFFFFF) != v_in32(VIRTIO_PCI_QUEUE_PFN)) return -1;
    if (*used_idx != *avail_idx) return -1;
    *avail_flags = 0;
    desc[0].addr = (unsigned long long)(u32)(unsigned long)a;
    desc[0].len = al;
    desc[0].flags = VRING_DESC_F_NEXT;
    desc[0].next = 1;
    if (desc_count == 3) {
        desc[1].addr = (unsigned long long)(u32)(unsigned long)b;
        desc[1].len = bl;
        desc[1].flags = VRING_DESC_F_NEXT;
        desc[1].next = 2;
        desc[2].addr = (unsigned long long)(u32)(unsigned long)r;
        desc[2].len = rl;
        desc[2].flags = VRING_DESC_F_WRITE;
        desc[2].next = 0;
    } else {
        desc[1].addr = (unsigned long long)(u32)(unsigned long)r;
        desc[1].len = rl;
        desc[1].flags = VRING_DESC_F_WRITE;
        desc[1].next = 0;
    }
    __sync_synchronize();
    start_idx = *avail_idx;
    avail_ring[start_idx % queue_size] = 0;
    __sync_synchronize();
    *avail_idx = (u16)(start_idx + 1);
    __sync_synchronize();
    v_out16(VIRTIO_PCI_QUEUE_NOTIFY, 0);
    __sync_synchronize();
    while (*used_idx != *avail_idx && spins++ < 100000u) io_wait_spin();
    if (*used_idx != *avail_idx) return -1;
    (void)v_in8(VIRTIO_PCI_ISR);
    return 0;
}

void virtio_gpu_probe(void){const pci_device_t*dev=pci_find_device(VIRTIO_VENDOR_ID,VIRTIO_GPU_DEVICE_ID_LEGACY);gpu.present=0;gpu.initialized=0;gpu.resource_width=0;gpu.resource_height=0;gpu.scanout_id=0;gpu_dev=0;io_base=0;queue_size=0;ready=0;if(!dev)return;gpu.present=1;gpu.bus=dev->bus;gpu.slot=dev->slot;gpu.function=dev->function;gpu.vendor_id=dev->vendor_id;gpu.device_id=dev->device_id;gpu.bar0=pci_read_bar32(dev,0);gpu.bar1=pci_read_bar32(dev,1);gpu_dev=dev;io_base=pci_bar0_io(dev);serial_write("[virtio-gpu] detected vendor=");serial_write_hex(gpu.vendor_id);serial_write(" device=");serial_write_hex(gpu.device_id);serial_write(" bar0=");serial_write_hex(gpu.bar0);serial_write(" bar1=");serial_write_hex(gpu.bar1);serial_write(" io=");serial_write_hex(io_base);serial_write("\n");}
const virtio_gpu_info_t* virtio_gpu_info(void){return &gpu;}
int virtio_gpu_available(void){return gpu.present;}
int virtio_gpu_init_safe(u32 width,u32 height){if(!gpu.present)return 0;gpu.resource_width=width;gpu.resource_height=height;gpu.scanout_id=0;if(!virtio_gpu_queue_init()){serial_write("[virtio-gpu] queue init failed; framebuffer remains active\n");gpu.initialized=0;return 0;}serial_write("[virtio-gpu] queue initialized; transport ready\n");return 1;}
int virtio_gpu_submit2(void *req, u32 req_len, void *resp, u32 resp_len){return virtio_gpu_submit_common(req,req_len,0,0,resp,resp_len,2);} 
int virtio_gpu_submit3(void *a, u32 al, void *b, u32 bl, void *r, u32 rl){return virtio_gpu_submit_common(a,al,b,bl,r,rl,3);} 
int virtio_gpu_get_display_size(u32 *width,u32 *height){virtio_gpu_get_display_info_t q;virtio_gpu_resp_display_info_t r;if(!width||!height||!ready)return -1;for(;;){q.hdr.type=VIRTIO_GPU_CMD_GET_DISPLAY_INFO;q.hdr.flags=0;q.hdr.fence_id=0;q.hdr.ctx_id=0;q.hdr.ring_idx=0;q.hdr.padding[0]=q.hdr.padding[1]=q.hdr.padding[2]=0;if(virtio_gpu_submit2(&q,sizeof(q),&r,sizeof(r))<0)return -2;if(r.hdr.type!=VIRTIO_GPU_RESP_OK_DISPLAY_INFO)return -3;if(!r.pmodes[0].enabled||!r.pmodes[0].r.width||!r.pmodes[0].r.height)return -4;*width=r.pmodes[0].r.width;*height=r.pmodes[0].r.height;return 0;}}
